# =============================================================================
# DocFlow API — environment template (COMMITTED, safe to share).
#
# Copy to `.env` and fill in your own values. Real `.env` is gitignored.
# Boot-time validation in `src/common/jwt.config.ts` rejects dev-/test-/etc-
# prefixed secrets — production deployments MUST generate fresh random values.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# ---- Database / infra ----
DATABASE_URL="postgresql://docflow:docflow@localhost:5432/docflow_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- Object storage ----
# STORAGE_DRIVER=local  -> files under UPLOADS_DIR (default ./uploads)
# STORAGE_DRIVER=s3     -> any S3-compatible store (MinIO in production)
STORAGE_DRIVER="local"
UPLOADS_DIR=""
S3_ENDPOINT="http://localhost:9000"
# Optional: endpoint the BROWSER can reach; enables presigned download URLs.
# Leave empty to serve downloads through the authenticated API route.
S3_PUBLIC_ENDPOINT=""
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="docflow"
S3_REGION="us-east-1"

# ---- Vision / LLM providers — gateway {URL, TOKEN, MODEL} per provider ----
# A provider is ACTIVE when its TOKEN is set. Auto-routing order (first
# active wins): VISION_PROVIDER_ORDER, default openrouter,gemini,minimax,openai,anthropic.
# Production uses Gemini 2.5 Flash THROUGH OpenRouter (OPENROUTER_API_KEY) —
# no direct Google key is needed. Legacy names (OPENROUTER_API_KEY,
# GEMINI_API_KEY, *_VISION_MODEL) still work.
VISION_PROVIDER_ORDER="openrouter,gemini,minimax,openai,anthropic"
# Below this confidence a second provider is consulted (one extra call).
VISION_SECOND_OPINION_CONFIDENCE="0.7"
GEMINI_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_TOKEN=""
GEMINI_MODEL="gemini-3.6-flash"
OPENROUTER_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_TOKEN=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_MODEL_ESCALATE="google/gemini-2.5-pro"
MINIMAX_URL="https://api.minimax.io/v1/chat/completions"
MINIMAX_TOKEN=""
MINIMAX_MODEL="MiniMax-M3"
OPENAI_URL="https://api.openai.com/v1/chat/completions"
OPENAI_TOKEN=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_URL=""
ANTHROPIC_TOKEN=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ---- JWT secrets ----
# REPLACE before deploying. Must NOT start with dev-/test-/change-/secret-.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ISSUER="docflow"
JWT_AUDIENCE="docflow-api"
JWT_ACCESS_TTL="15m"

# ---- Other ----
CRON_SECRET=""

# ---- Inbound email webhook signing ----
# At least ONE of the three provider secrets must be set or DocFlow will
# reject every inbound webhook with HTTP 503 (fail-closed, AUDIT §5.1):
#   SENDGRID_INBOUND_SECRET   — HMAC-SHA256 shared secret for SendGrid's
#                                Inbound Parse webhook (legacy). Signature
#                                header: x-sendgrid-signature.
#   SENDGRID_WEBHOOK_PUBLIC_KEY — PEM-encoded ECDSA public key for
#                                SendGrid's Signed Email feature. Crypto
#                                is preferred — uses an asymmetric key
#                                so the server never sees the private
#                                half. See:
#   https://developers.sendgrid.com/docs/for-developers/signing-email/verifying-your-signed-email/
#   MAILGUN_WEBHOOK_SIGNING_KEY — HMAC-SHA256 for Mailgun's route events.
TWO_FACTOR_ISSUER="DocFlow"
